# Leave these blank to trade the account already logged in on the open MT5 terminal.
# If you fill them in, copy the server name exactly from the Exness login window
# (demo servers look like Exness-MT5Trial7).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional. Use this when more than one MT5 terminal is installed.
# Example: C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe
MT5_PATH=
